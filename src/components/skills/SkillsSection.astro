---
import { skillGroups } from "@data/skills";
---

<section class="section-block">
  <div class="site-shell">
    <div class="section-heading stacked">
      <h2>Skills</h2>
      <p>Technologies and tools I work with</p>
    </div>

    <div class="skills-list">
      {
        skillGroups.map((group) => (
          <div class="skill-row">
            <h3>{group.category}</h3>
            <div class="skill-grid">
              {group.items.map((item) => (
                <div class="skill-tile">
                  <span class="skill-mark" aria-hidden="true">
                    <img src={item.iconUrl} alt="" loading="lazy" onerror="this.hidden = true; this.nextElementSibling.hidden = false;" />
                    <span hidden>{item.name.slice(0, 2)}</span>
                  </span>
                  <span>{item.name}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
