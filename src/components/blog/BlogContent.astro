---
import { ArrowRight, CalendarDays, Clock, MessageCircle, ThumbsUp } from "lucide-astro";
import { blogPageData } from "@data/blogPage";
import { getArticles, type Article } from "@utils/articles";

const { articles, enabledSources, failedSources } = await getArticles();
const hasFetchError = enabledSources.length > 0 && failedSources.length === enabledSources.length;
const formatPublishedDate = (article: Article) =>
  new Date(article.publishedAt).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric"
  });
---

<section class="section-block page-hero page-hero-blog">
  <div class="site-shell page-hero-grid">
    <div>
      <span class="eyebrow page-eyebrow">{blogPageData.hero.eyebrow}</span>
      <h1>{blogPageData.hero.title}</h1>
      <p class="page-hero-description">{blogPageData.hero.description}</p>
    </div>
    <aside class="page-hero-image">
      <img src={blogPageData.hero.heroImage} alt={blogPageData.hero.heroImageAlt} />
    </aside>
  </div>
</section>

<section class="section-block">
  <div class="site-shell">
    {articles.length > 0 ? (
      <div class="blog-grid blog-grid-page">
        {articles.map((article) => (
          <article class="blog-card blog-card-page">
            <a class="blog-image" href={article.url} target="_blank" rel="noreferrer">
              {article.image ? (
                <img
                  src={article.image}
                  alt={article.title}
                  loading="lazy"
                />
              ) : (
                <span>{article.title}</span>
              )}
            </a>

            <div class="blog-body">
              <div class="blog-meta">
                <span>
                  <CalendarDays size={15} aria-hidden="true" />
                  {article.sourceName} · <time datetime={article.publishedAt}>{formatPublishedDate(article)}</time>
                </span>
                {article.readingTimeMinutes !== undefined && (
                  <span>
                    <Clock size={15} aria-hidden="true" />
                    {article.readingTimeMinutes} min read
                  </span>
                )}
              </div>

              <h3>
                <a href={article.url} target="_blank" rel="noreferrer">{article.title}</a>
              </h3>
              {article.description && <p>{article.description}</p>}

              {article.tags.length > 0 && (
                <div class="tag-list">
                  {article.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
                </div>
              )}
            </div>

            <div class="blog-footer">
              {article.reactionsCount !== undefined && (
                <span>
                  <ThumbsUp size={15} aria-hidden="true" />
                  {article.reactionsCount}
                </span>
              )}
              {article.commentsCount !== undefined && (
                <span>
                  <MessageCircle size={15} aria-hidden="true" />
                  {article.commentsCount}
                </span>
              )}
              <a href={article.url} target="_blank" rel="noreferrer">
                Read article <ArrowRight size={15} aria-hidden="true" />
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <h2>{hasFetchError ? "Blog posts could not be loaded." : "No posts available yet."}</h2>
        <p>
          {hasFetchError
            ? "There was an issue loading posts from the blog source. Please try again later."
            : "New writing will appear here once published."}
        </p>
      </div>
    )}
  </div>
</section>

<section class="section-block page-cta-section">
  <div class="site-shell page-cta-panel">
    <div>
      <p class="eyebrow page-cta-eyebrow">{blogPageData.cta.title}</p>
      <p>{blogPageData.cta.description}</p>
    </div>
    <div class="page-cta-actions">
      {blogPageData.cta.actions.map((action) => (
        <a
          class={`button ${action.variant}`}
          href={action.href}
          download={action.download}
          target={action.href.startsWith("http") ? "_blank" : undefined}
          rel={action.href.startsWith("http") ? "noreferrer" : undefined}
        >
          {action.label}
        </a>
      ))}
    </div>
  </div>
</section>
