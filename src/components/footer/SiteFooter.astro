---
import { ArrowUp, Download, Github, Linkedin } from "lucide-astro";
import { footerContent, siteMeta } from "@data/site";

const renderIcon = (icon: string) => {
  const icons = {
    download: Download,
    github: Github,
    linkedin: Linkedin
  };

  return icons[icon as keyof typeof icons];
};
---

<footer class="footer-section">
  <div class="site-shell footer-grid">
    <div class="footer-intro">
      <h2>{footerContent.heading}</h2>
      <p>{footerContent.description}</p>
    </div>

    {
      footerContent.links.map((link) => {
        const Icon = renderIcon(link.icon);

        return (
          <a
            class="footer-link"
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
            download={link.download}
          >
            <Icon size={24} aria-hidden="true" />
            <span><strong>{link.label}</strong> {link.displayText}</span>
          </a>
        );
      })
    }
  </div>

  <div class="site-shell footer-bottom">
    <p>&copy; {siteMeta.copyright}</p>
    <a class="back-to-top" href="#top" aria-label={footerContent.backToTopLabel}>
      <ArrowUp size={18} aria-hidden="true" />
    </a>
  </div>
</footer>
