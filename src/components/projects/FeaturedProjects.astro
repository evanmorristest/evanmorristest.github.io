---
import { ArrowRight, ExternalLink, Github } from "lucide-astro";
import { featuredProjects } from "@data/projects";
import { sectionContent } from "@data/site";

const section = sectionContent.featuredProjects;
---

<section class="section-block">
  <div class="site-shell">
    <div class="section-heading">
      <div>
        <h2>{section.title}</h2>
      </div>
      <a class="text-link" href={section.viewAllHref}>
        {section.viewAllLabel} <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>

    <div class="project-grid">
      {
        featuredProjects.map((project, index) => (
          <article class="project-card">
            <a class={`project-image project-image-${index + 1}`} href={project.href}>
              <span>{project.imageLabel}</span>
            </a>
            <div class="project-body">
              <h3><a href={project.href}>{project.title}</a></h3>
              <p>{project.summary}</p>
              <div class="tag-list">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
            <div class="project-links">
              <a href={project.demoUrl}>
                {section.liveDemoLabel} <ExternalLink size={15} aria-hidden="true" />
              </a>
              <a href={project.githubUrl} target="_blank" rel="noreferrer">
                {section.githubLabel} <Github size={15} aria-hidden="true" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
