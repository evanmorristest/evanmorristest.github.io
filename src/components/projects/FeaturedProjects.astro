---
import { ArrowRight, ExternalLink, GitFork, Github, Star } from "lucide-astro";
import { sectionContent } from "@data/site";
import { getFeaturedGitHubProjects, getGitHubProjects, type Project } from "@utils/githubProjects";

interface Props {
  mode?: "featured" | "all";
}

const { mode = "featured" } = Astro.props;
const section = mode === "featured" ? sectionContent.featuredProjects : sectionContent.projectsIndex;
const projectLabels = sectionContent.featuredProjects;

let projects: Project[] = [];
let hasFetchError = false;

try {
  projects = mode === "featured" ? await getFeaturedGitHubProjects() : await getGitHubProjects();
} catch (error) {
  hasFetchError = true;
  console.error(projectLabels.emptyTitle, error);
}
---

<section class="section-block">
  <div class="site-shell">
    <div class="section-heading">
      <div>
        <h2>{section.title}</h2>
      </div>
      {
        mode === "featured" && (
          <a class="text-link" href={projectLabels.viewAllHref}>
            {projectLabels.viewAllLabel} <ArrowRight size={16} aria-hidden="true" />
          </a>
        )
      }
    </div>

    {
      projects.length > 0 ? (
        <div class="project-grid">
          {projects.map((project, index) => (
            <article class="project-card">
              <a
                class={`project-image project-image-${(index % 3) + 1}`}
                href={project.githubUrl}
                target="_blank"
                rel="noreferrer"
              >
                <span>{project.imageLabel}</span>
              </a>
              <div class="project-body">
                <h3><a href={project.githubUrl} target="_blank" rel="noreferrer">{project.title}</a></h3>
                <p>{project.summary}</p>
                <div class="tag-list">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
                <div class="project-meta">
                  <span title={projectLabels.starsLabel}>
                    <Star size={15} aria-hidden="true" />
                    {project.stars}
                  </span>
                  <span title={projectLabels.forksLabel}>
                    <GitFork size={15} aria-hidden="true" />
                    {project.forks}
                  </span>
                  <span>{projectLabels.updatedLabel} {new Date(project.updatedAt).toLocaleDateString("en-GB")}</span>
                </div>
              </div>
              <div class="project-links">
                {project.demoUrl && (
                  <a href={project.demoUrl} target="_blank" rel="noreferrer">
                    {projectLabels.liveDemoLabel} <ExternalLink size={15} aria-hidden="true" />
                  </a>
                )}
                <a href={project.githubUrl} target="_blank" rel="noreferrer">
                  {projectLabels.githubLabel} <Github size={15} aria-hidden="true" />
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h2>{hasFetchError ? projectLabels.emptyTitle : sectionContent.projectsIndex.emptyTitle}</h2>
          <p>{hasFetchError ? projectLabels.emptyDescription : sectionContent.projectsIndex.emptyDescription}</p>
        </div>
      )
    }
  </div>
</section>
