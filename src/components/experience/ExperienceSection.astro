---
import { Award, BriefcaseBusiness, ExternalLink, GraduationCap } from "lucide-astro";
import { certifications, education, workExperience } from "@data/experience";
import { sectionContent } from "@data/site";

const section = sectionContent.experience;

const timelineGroups = [
  {
    title: section.workTitle,
    icon: BriefcaseBusiness,
    items: workExperience.map((item) => ({
      ...item,
      source: item.company
    }))
  },
  {
    title: section.educationTitle,
    icon: GraduationCap,
    items: education.map((item) => ({
      ...item,
      source: item.institution
    }))
  },
  {
    title: section.certificationsTitle,
    icon: Award,
    className: "certifications-panel",
    items: certifications.map((item) => ({
      ...item,
      source: item.issuer
    }))
  }
];
---

<section class="section-block experience-section">
  <div class="site-shell">
    <div class="section-heading stacked">
      <h2>{section.title}</h2>
    </div>

    <div class="experience-grid">
      {
        timelineGroups.map((group) => {
          const Icon = group.icon;

          return (
            <div class={group.className}>
              <h3 class="timeline-title">
                <Icon size={20} aria-hidden="true" />
                {group.title}
              </h3>
              <div class="timeline">
                {group.items.map((item) => (
                  <article class="timeline-item">
                    <div class="timeline-head">
                      <h4>{item.title}</h4>
                      <span>{item.timeline}</span>
                    </div>
                    <p class="timeline-company">{item.source}</p>
                    <p>{item.description}</p>
                    {"credentialUrl" in item && item.credentialUrl && (
                      <a class="timeline-link" href={item.credentialUrl} target="_blank" rel="noreferrer">
                        {section.credentialLabel} <ExternalLink size={14} aria-hidden="true" />
                      </a>
                    )}
                  </article>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
