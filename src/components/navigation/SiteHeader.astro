---
import { Menu, X } from "lucide-astro";
import { navigationItems } from "@data/navigation";
import { navigationContent } from "@data/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="site-shell header-inner">
    <a href="/" class="brand" aria-label={navigationContent.homeAriaLabel}>{navigationContent.brandLabel}</a>

    <nav class="desktop-nav" aria-label={navigationContent.primaryAriaLabel}>
      {
        navigationItems.map((item) => (
          <a href={item.href} class:list={["nav-link", { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <button class="menu-toggle" type="button" aria-label={navigationContent.openMenuLabel} aria-expanded="false">
      <Menu class="menu-open" size={22} aria-hidden="true" />
      <X class="menu-close" size={22} aria-hidden="true" />
    </button>
  </div>
</header>

<nav class="mobile-nav" aria-label={navigationContent.mobileAriaLabel}>
  <button class="mobile-close" type="button" aria-label={navigationContent.closeMenuLabel}>
    <X size={24} aria-hidden="true" />
  </button>
  {
    navigationItems.map((item) => (
      <a href={item.href} class:list={["mobile-link", { active: isActive(item.href) }]}>
        {item.label}
      </a>
    ))
  }
</nav>

<script define:vars={{ openMenuLabel: navigationContent.openMenuLabel, closeMenuLabel: navigationContent.closeMenuLabel }}>
  document.addEventListener("DOMContentLoaded", () => {
    const header = document.querySelector(".site-header");
    const mobileNav = document.querySelector(".mobile-nav");
    const toggle = document.querySelector(".menu-toggle");

    if (toggle && toggle instanceof HTMLButtonElement) {
      toggle.addEventListener("click", () => {
        const isOpen = mobileNav?.classList.toggle("mobile-open") ?? false;
        header?.classList.toggle("mobile-open", isOpen);
        toggle.setAttribute("aria-expanded", String(isOpen));
        toggle.setAttribute("aria-label", isOpen ? closeMenuLabel : openMenuLabel);
      });
    }
    const mobileClose = document.querySelector(".mobile-close");
    if (mobileClose && mobileClose instanceof HTMLButtonElement) {
      mobileClose.addEventListener("click", () => {
        mobileNav?.classList.remove("mobile-open");
        header?.classList.remove("mobile-open");
        if (toggle && toggle instanceof HTMLButtonElement) {
          toggle.setAttribute("aria-expanded", "false");
          toggle.setAttribute("aria-label", openMenuLabel);
        }
      });
    }
  });
</script>
