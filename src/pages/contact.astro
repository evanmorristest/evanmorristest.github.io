---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageIntro from "@components/shared/PageIntro.astro";
import { socialLinks } from "@data/socialLinks";
---

<BaseLayout title="Contact | Software Engineer Portfolio">
  <PageIntro
    eyebrow="Contact"
    title="Start a conversation about a project, role, or collaboration."
    description="Use the placeholder links below for now. These can be replaced with the final email, social profiles, and resume before launch."
  />

  <section class="section-block compact-section">
    <div class="site-shell contact-panel">
      <a href={`mailto:${socialLinks.email}`}>Email: {socialLinks.email}</a>
      <a href={socialLinks.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={socialLinks.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a href={socialLinks.resume}>Resume PDF</a>
    </div>
  </section>
</BaseLayout>

