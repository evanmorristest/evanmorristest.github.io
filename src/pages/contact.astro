---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageIntro from "@components/shared/PageIntro.astro";
import { contactContent, pageContent } from "@data/site";

const page = pageContent.contact;
---

<BaseLayout title={page.metaTitle}>
  <PageIntro
    eyebrow={page.eyebrow}
    title={page.title}
    description={page.description}
  />

  <section class="section-block compact-section">
    <div class="site-shell contact-panel">
      {
        contactContent.links.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
            download={link.download}
          >
            {link.text}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
