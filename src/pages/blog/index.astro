---
import { CalendarDays, Clock, ExternalLink, MessageCircle, ThumbsUp } from "lucide-astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageIntro from "@components/shared/PageIntro.astro";

interface DevArticle {
  id: number;
  title: string;
  description: string;
  cover_image: string | null;
  social_image: string;
  readable_publish_date: string;
  tag_list: string[];
  url: string;
  comments_count: number;
  public_reactions_count: number;
  reading_time_minutes: number;
}

const DEV_USERNAME = "evanmorris";
const DEV_ARTICLES_URL = `https://dev.to/api/articles?username=${DEV_USERNAME}&per_page=9`;

let articles: DevArticle[] = [];
let hasFetchError = false;

try {
  const response = await fetch(DEV_ARTICLES_URL, {
    headers: {
      "User-Agent": "evanmorristest.github.io portfolio site"
    }
  });

  if (!response.ok) {
    throw new Error(`DEV API responded with ${response.status}`);
  }

  articles = await response.json();
} catch (error) {
  hasFetchError = true;
  console.error("Unable to fetch DEV articles", error);
}
---

<BaseLayout title="Blog | Software Engineer Portfolio">
  <PageIntro
    eyebrow="Blog"
    title="Notes on software engineering, automation, and building better tools."
    description="Latest writing pulled from DEV, keeping articles in one publishing workflow while presenting them inside this portfolio."
  />

  <section class="section-block">
    <div class="site-shell">
      <div class="section-heading">
        <div>
          <h2>Latest Articles</h2>
          <p>Fetched from dev.to/{DEV_USERNAME}</p>
        </div>
        <a class="text-link" href={`https://dev.to/${DEV_USERNAME}`} target="_blank" rel="noreferrer">
          View on DEV <ExternalLink size={16} aria-hidden="true" />
        </a>
      </div>

      {
        articles.length > 0 ? (
          <div class="blog-grid">
            {articles.map((article) => (
              <article class="blog-card">
                <a class="blog-image" href={article.url} target="_blank" rel="noreferrer">
                  {article.cover_image || article.social_image ? (
                    <img
                      src={article.cover_image ?? article.social_image}
                      alt=""
                      loading="lazy"
                    />
                  ) : (
                    <span>{article.title}</span>
                  )}
                </a>

                <div class="blog-body">
                  <div class="blog-meta">
                    <span>
                      <CalendarDays size={15} aria-hidden="true" />
                      {article.readable_publish_date}
                    </span>
                    <span>
                      <Clock size={15} aria-hidden="true" />
                      {article.reading_time_minutes} min read
                    </span>
                  </div>

                  <h3>
                    <a href={article.url} target="_blank" rel="noreferrer">
                      {article.title}
                    </a>
                  </h3>
                  <p>{article.description}</p>

                  <div class="tag-list">
                    {article.tag_list.slice(0, 4).map((tag) => <span>{tag}</span>)}
                  </div>
                </div>

                <div class="blog-footer">
                  <span>
                    <ThumbsUp size={15} aria-hidden="true" />
                    {article.public_reactions_count}
                  </span>
                  <span>
                    <MessageCircle size={15} aria-hidden="true" />
                    {article.comments_count}
                  </span>
                  <a href={article.url} target="_blank" rel="noreferrer">
                    Read article <ExternalLink size={15} aria-hidden="true" />
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>{hasFetchError ? "Articles could not be loaded." : "No DEV articles found yet."}</h2>
            <p>
              {hasFetchError
                ? "The DEV API request failed during page generation. The route is still available and will populate on the next successful build."
                : `Publish articles under the ${DEV_USERNAME} DEV account and they will appear here automatically.`}
            </p>
            <a class="button secondary" href={`https://dev.to/${DEV_USERNAME}`} target="_blank" rel="noreferrer">
              Open DEV Profile <ExternalLink size={17} aria-hidden="true" />
            </a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
