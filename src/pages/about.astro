---
import BaseLayout from "@layouts/BaseLayout.astro";
import AboutContent from "@components/about/AboutContent.astro";
import PageIntro from "@components/shared/PageIntro.astro";
import { pageContent } from "@data/site";

const page = pageContent.about;
---

<BaseLayout title={page.metaTitle}>
  <PageIntro
    eyebrow={page.eyebrow}
    title={page.title}
    description={page.description}
  />
  <AboutContent />
</BaseLayout>
