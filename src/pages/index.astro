---
import BaseLayout from "@layouts/BaseLayout.astro";
import ExperienceSection from "@components/experience/ExperienceSection.astro";
import HeroSection from "@components/hero/HeroSection.astro";
import FeaturedProjects from "@components/projects/FeaturedProjects.astro";
import SkillsSection from "@components/skills/SkillsSection.astro";
import { siteMeta } from "@data/site";
---

<BaseLayout
  title={siteMeta.homeTitle}
  description={siteMeta.homeDescription}
>
  <HeroSection />
  <FeaturedProjects />
  <SkillsSection />
  <ExperienceSection />
</BaseLayout>
